<!DOCTYPE html>
<html>
<head>
    <title>Men Salon - Catalogue</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">

    <!-- Internal CSS -->
    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
            text-align: center;
        }

        .catalogue {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            margin: 40px;
        }

        .service {
            background: white;
            width: 220px;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
        }

        .service h3 {
            color: darkblue;
        }

        .service p {
            font-size: 16px;
        }

        .price {
            color: green;
            font-weight: bold;
        }

        button {
            background: darkblue;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: green;
        }
    </style>
</head>

<body>

    <h1 style="color:darkred;">Men Salon</h1>

    <nav>
        <a href="index.html">Home</a>
        <a href="catalogue.html" class="active">Catalogue</a>
        <a href="login.html">Login</a>
        <a href="registration.html">Register</a>
    </nav>

    <h2>Our Services</h2>

    <div class="catalogue">

        <div class="service">
            <h3>Hair Cut</h3>
            <p>Stylish haircut by our professional staff.</p>
            <p class="price">₹200</p>
            <button onclick="bookService('Hair Cut')">Book Now</button>
        </div>

        <div class="service">
            <h3>Beard Trim</h3>
            <p>Professional beard trimming and styling.</p>
            <p class="price">₹150</p>
            <button onclick="bookService('Beard Trim')">Book Now</button>
        </div>

        <div class="service">
            <h3>Hair Spa</h3>
            <p>Relaxing hair spa for healthy and smooth hair.</p>
            <p class="price">₹500</p>
            <button onclick="bookService('Hair Spa')">Book Now</button>
        </div>

        <div class="service">
            <h3>Facial</h3>
            <p>Complete facial treatment for fresh skin.</p>
            <p class="price">₹400</p>
            <button onclick="bookService('Facial')">Book Now</button>
        </div>

    </div>

    <!-- JavaScript -->
    <script>
        function bookService(service) {
            alert(service + " selected!");
            window.location.href = "registration.html";
        }
    </script>

</body>
</html>
